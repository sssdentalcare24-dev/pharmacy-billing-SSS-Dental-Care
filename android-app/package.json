{
  "name": "ssdc-billing-android",
  "version": "3.1.0",
  "private": true,
  "description": "Android app (Capacitor) for Sri Sai Speciality Dental Care billing \u2014 wraps the website in this repository",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && npx cap sync android",
    "open": "npx cap open android",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor-community/bluetooth-le": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
